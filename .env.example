# Copy this file to .env and fill it in. NEVER commit your .env.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------- Discord ---
# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Prefix for commands and for talking to the bot ("v! hello")
PREFIX=v!

# Comma-separated channel IDs the bot may answer in. Empty = all channels.
ALLOWED_CHANNEL_IDS=

# ---------------------------------------------------------- LLM providers ---
# Tried in this order; if one fails or hits its free limit, the next answers.
# Fill in at least ONE key. Providers without a key are skipped.
PROVIDERS=groq,gemini,openrouter

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# https://openrouter.ai/keys  (free models end in ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Any OpenAI-compatible server (Ollama, LM Studio, a paid API...).
# Add "custom" to PROVIDERS to use it. Example for local Ollama:
#   CUSTOM_BASE_URL=http://localhost:11434/v1
#   CUSTOM_MODEL=llama3.2
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# ------------------------------------------------------------ Personality ---
PERSONA_FILE=personas/default.md

# ---------------------------------------------------------------- Behavior ---
# Messages remembered per channel (from everyone, not just the bot)
HISTORY_SIZE=30
# Chance (0-1) of joining a conversation without being called. 0 = off
CHIME_IN_CHANCE=0
# Minimum seconds between replies to the same user (protects your free quota)
USER_COOLDOWN=3
TEMPERATURE=0.8
MAX_TOKENS=400

# ------------------------------------------------------------------ Memory ---
# "memory" = RAM, lost on restart | "sqlite" = saved to a file
MEMORY_BACKEND=memory
SQLITE_PATH=data/memory.db

# --------------------------------------------------------- Canned replies ---
# Leave empty to use the built-in English defaults.
MSG_ERROR=
MSG_RESET=
# Sent when a user is on cooldown. Empty = silently ignore.
MSG_COOLDOWN=

# ------------------------------------------------------------------- Misc ---
LOG_LEVEL=INFO
# Comma-separated cog names to disable (e.g. admin)
DISABLED_COGS=
